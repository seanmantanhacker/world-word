<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">


    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Game Lobby</title>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.0/jquery.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/home.css" />
    <audio id="music1" loop >
        <source src="/music/warrior_30sec-intro-192837.mp3">
        Your browser does not support the audio element.
    </audio>
    
    </head>
    <body class="bg2">
        <div class="overlay"></div>
        <div class="main-wrapper">
          <div class="container">
            <div class="panel panel-default center">
              <div class="panel-heading">
                <div class="badge-title">GLOBAL MULTIPLAYER</div>
                <h1 class="game-title">WORLD WORD</h1>
                <p class="game-subtitle">The World's Most Fascinating Sci-Fi Word Game</p>
                <% if (roomId) { %>
                <div class="lobby-header">
                  <span class="lobby-label">GAME LOBBY</span>
                </div>
                <div class="room-code-display">ROOM CODE: <span><%= roomId %></span></div>
                <h2 id="timer" class="hidden"></h2>
                <% } %>
              </div>
              <% if (roomId) { %>
              <div class="players-card">
                <div class="card-header-sm">JOINED PLAYERS</div>
                <div id="list-group" class="center">
                    <% for (i =0 ; i < Object.keys(peserta).length; i++) { %>
                        <button class="center-button"><%=peserta[Object.keys(peserta)[i]].name;%></button>
                    <% }%>
                </div>
              </div>
            </div>
            <div class="panel-action-card">
              <div class="username center">
                <label class="panel-body" for="uname">ENTER YOUR CALLSIGN</label>
                <div class="input-glow-wrapper">
                  <input class="form-control" type="text" placeholder="Callsign / Username..." name="uname" autocomplete="off" required>
                </div>
              </div>
              <div class="button-group center">
                <button id="join-button" class="center-button2 btn-glow-cyan" type="button">JOIN LOBBY</button>
                <button id="start-button" class="remove center-button2 btn-glow-purple" type="button">START GAME</button>
              </div>
            </div>
            <% } else { %>
              </div>
            <div class="panel-action-card">
              <div class="button-group center">
                <button id="create-room-button" class="center-button2 btn-glow-cyan" type="button">CREATE ROOM</button>
              </div>
              <div class="username center">
                <label class="panel-body" for="room-code">JOIN WITH A ROOM CODE</label>
                <div class="input-glow-wrapper">
                  <input class="form-control" type="text" placeholder="e.g. 7K2Q" name="room-code" id="room-code-input" autocomplete="off" maxlength="4">
                </div>
              </div>
              <div class="button-group center">
                <button id="join-room-button" class="center-button2 btn-glow-purple" type="button">JOIN ROOM</button>
              </div>
              <p id="join-room-error" class="hidden"></p>
            </div>
            <% } %>
          </div>
        </div>
    <!-- jQuery (necessary for Bootstrap's JavaScript plugins) -->
    
      
  </body>
</html>
<script>
    function generateUUID() { // Public Domain/MIT
    var d = new Date().getTime();//Timestamp
    var d2 = ((typeof performance !== 'undefined') && performance.now && (performance.now()*1000)) || 0;//Time in microseconds since page-load or 0 if unsupported
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        var r = Math.random() * 16;//random number between 0 and 16
        if(d > 0){//Use timestamp until depleted
            r = (d + r)%16 | 0;
            d = Math.floor(d/16);
        } else {//Use microseconds since page-load if supported
            r = (d2 + r)%16 | 0;
            d2 = Math.floor(d2/16);
        }
        return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
    });
}
</script>
<script>
    var myId = ""
    const my_uuid = localStorage.getItem("uuid");
        
        if (my_uuid == null){
            let myuuid = generateUUID();
            
            localStorage.setItem("uuid", myuuid);
            myId = myuuid
        } else {
            myId = my_uuid
        }      
    var start_able = true
    var audio1 = document.getElementById("music1");
    var state = <%-JSON.stringify(state)%>;
    var roomId = <%-JSON.stringify(roomId)%>;
    if (roomId && state.gameStart){
        $("#join-button").addClass("hidden")
        window.location.href = "/room/" + roomId + "/loading?id=" + myId
    }
    console.log(state.gameStart)
    var app = {
        socket: null,
        connect: function() {
            var self = this;
            if( self.socket ) {
                self.socket.destroy();
                delete self.socket;
                self.socket = null;
            }
            this.socket = io.connect({
                reconnection: true,
                reconnectionDelay: 1000,
                reconnectionDelayMax : 5000,
                reconnectionAttempts: Infinity
            } );
            this.socket.on( 'connect', function () {
                             
                console.log( 'connected to server' );
            } );
            this.socket.on( 'disconnect', function () {
                console.log( 'disconnected from server' );
                window.setTimeout( 'app.connect()', 5000 );
            } );
            this.socket.on( 'join lobby', function (msg) {
                
                if (msg.assignUser == myId){
                    $( "#join-button" ).off();
                    $("#join-button").addClass("remove");
                }
                $( "#list-group" ).empty()
                pesertaa = msg.peserta
                for (i =0 ; i < Object.keys(pesertaa).length; i++){
                    
                    $( "#list-group" ).append(`<button class="center-button">${pesertaa[Object.keys(pesertaa)[i]].name}</button>`);
                }
            
                if (pesertaa[myId].host){
                    $( "#start-button" ).removeClass( "remove" )
                }
            } );

            this.socket.on('set-session-acknowledgement', function(data){
                sessionStorage.setItem('sessionId', data.sessionId);
            })

            this.socket.on( 'timer game start', function (msg) {
                console.log(msg)

                $( "#timer" ).removeClass( "hidden" )
                $( "#timer" ).text(msg)

                if (msg <= 0){
                    window.location.href = "/room/" + roomId + "/loading"
                }


            } );
        }
} // app
    
    // A $( document ).ready() block.
    $( document ).ready(function() {


        $( "#join-button" ).on( "click", function() {
            app.connect();
            uname=  $(".username").find('input[name="uname"]').val()
            data ={
                from : myId,
                uname : uname,
                roomId : roomId
            }
            audio1.play();
            app.socket.emit('join lobby', data);
        });

        $( "#start-button" ).on( "click", function() {
            if (start_able){
                audio1.pause()
                start_able = false
                app.socket.emit('game start', "null");
            }


        });

        $( "#create-room-button" ).on( "click", function() {
            window.location.href = "/create-room"
        });

        $( "#join-room-button" ).on( "click", function() {
            var code = $( "#room-code-input" ).val().trim().toUpperCase()
            if (code.length === 0){
                $( "#join-room-error" ).removeClass("hidden").text("Enter a room code first.")
                return
            }
            window.location.href = "/room/" + code
        });
    });


